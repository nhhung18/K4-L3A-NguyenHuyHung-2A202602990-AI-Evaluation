# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then replace the placeholder value.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional OpenAI-compatible API endpoint. OpenRouter keys are detected automatically.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter model IDs should include the provider prefix, e.g. openai/gpt-4o-mini.
